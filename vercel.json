{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/regalo", "destination": "/" },
    { "source": "/noche/regalo", "destination": "/noche" },
    { "source": "/dia/regalo", "destination": "/dia" },
    { "source": "/invitacion", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
